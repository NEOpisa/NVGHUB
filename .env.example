# Chave da API do Resend, usada por src/app/api/contact/route.ts
# para enviar os e-mails do formulário de contato.
RESEND_API_KEY=

# Supabase — usado por src/app/api/lead/route.ts (server-side) para registrar
# os atendimentos na tabela "Clientes" (mesmo banco do site de planejamento).
# A anon key legada está DESLIGADA no projeto; a rota é server-side e usa a
# SECRET key (bypassa RLS). Nunca exponha a secret no client / não versione.
# SUPABASE_URL: Project Settings → API → Project URL
# SUPABASE_SECRET_KEY: Project Settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Meta Pixel — usado pela página de anúncio (/anuncio) em src/components/MetaPixel.tsx.
# Precisa do prefixo NEXT_PUBLIC_ (exposto ao navegador). Configure na Vercel
# em Project Settings → Environment Variables.
NEXT_PUBLIC_FB_PIXEL_ID=
