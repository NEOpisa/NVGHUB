# Chave da API do Resend, usada por src/app/api/contact/route.ts
# para enviar os e-mails do formulário de contato.
RESEND_API_KEY=

# Supabase — usado por src/app/api/lead/route.ts para registrar os pedidos
# de orçamento/pacote na tabela "Clientes" (mesmo banco do site de planejamentos).
# SUPABASE_URL: Project Settings → API → Project URL
# SUPABASE_ANON_KEY: Project Settings → API → Project API keys → anon public
SUPABASE_URL=
SUPABASE_ANON_KEY=
